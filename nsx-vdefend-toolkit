#!/usr/bin/env python3
"""Compatibility shim.

This file was renamed to nsx-toolkit.py, which is what its own --help and
documentation always claimed it was called. This shim keeps existing scripts
and muscle memory working; it simply runs the real toolkit next to it.
"""

import os
import runpy
import sys

REAL = os.path.join(os.path.dirname(os.path.abspath(__file__)), "nsx-toolkit.py")

if not os.path.isfile(REAL):
    sys.stderr.write(
        "nsx-toolkit.py was not found next to this shim.\n"
        "Download it from the repository root and run that instead.\n")
    sys.exit(2)

sys.stderr.write("note: renamed to nsx-toolkit.py -- running that.\n")
sys.argv[0] = REAL
runpy.run_path(REAL, run_name="__main__")
