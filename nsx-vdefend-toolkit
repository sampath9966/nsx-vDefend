def table(headers, rows, indent=2):
    if not rows: say(" " * indent + cD("(no data)")); return
    widths = [len(h) for h in headers]
    sr = []
    for row in rows:
        cells = [str(c) for c in row]
        while len(cells) < len(headers): cells.append("")
        sr.append(cells)
        for i, c in enumerate(cells):
            if i < len(widths):
                widths[i] = max(widths[i], len(re.sub(r"\033\[[0-9;]*m", "", c)))
    pad = " " * indent
    say(pad + "  ".join(cB(h.ljust(widths[i])) for i, h in enumerate(headers)))
    say(pad + "  ".join(cD("-" * widths[i]) for i in range(len(headers))))
    for cells in sr:
        parts = []
        for i, c in enumerate(cells):
            cl = len(re.sub(r"\033\[[0-9;]*m", "", c))
            parts.append(c.ljust(widths[i] + len(c) - cl))
        say(pad + "  ".join(parts))

class Spinner:
    FRAMES = ["|", "/", "-", "\\"]
    def __init__(self, label="Working"):
        self._label, self._stop, self._thread = label, threading.Event(), None
    def __enter__(self):
        if _json_mode: return self
        self._stop.clear()
        self._thread = threading.Thread(target=self._spin, daemon=True)
        self._thread.start(); return self
    def __exit__(self, *_):
        if self._thread:
            self._stop.set(); self._thread.join(timeout=2)
            sys.stdout.write("\r" + " " * (len(self._label) + 12) + "\r")
            sys.stdout.flush()
    def _spin(self):
        i = 0
        while not self._stop.is_set():
            sys.stdout.write(f"\r  {cC(self.FRAMES[i%4])} {self._label} ...")
            sys.stdout.flush(); i += 1; self._stop.wait(0.15)

def parallel_run(sessions, fn, label="Querying", max_workers=8):
    results = {}; n = len(sessions)
    if n == 0: return results
    with ThreadPoolExecutor(max_workers=min(n, max_workers)) as pool:
        futures = {pool.submit(fn, s): s for s in sessions}
        done = 0
        for future in as_completed(futures):
            done += 1; s = futures[future]
            if not _json_mode:
                sys.stdout.write(f"\r  {cC(f'[{done}/{n}]')} {label} ...")
                sys.stdout.flush()
            try: results[s.name] = future.result()
            except Exception as e: results[s.name] = e
    if not _json_mode:
        sys.stdout.write("\r" + " " * 60 + "\r"); sys.stdout.flush()
    return results

# === AUDIT LOG ===
class AuditLog:
    def __init__(self, path=None):
        self.path = path or DEFAULT_AUDIT_FILE
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
    def log(self, action, manager, vm_name, vm_ext_id, tags_before, tags_after,
            status="success", detail=""):
        entry = {"timestamp": _utc_now_iso(),
                 "user": os.environ.get("USERNAME") or os.environ.get("USER", "unknown"),
                 "host": platform.node(), "manager": manager, "action": action,
                 "vm_display_name": vm_name, "vm_external_id": vm_ext_id,
                 "tags_before": [{"scope": s, "tag": t} for s, t in tags_before],
                 "tags_after": [{"scope": s, "tag": t} for s, t in tags_after],
                 "status": status, "detail": detail}
        try:
            with open(self.path, "a", encoding="utf-8") as f:
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
        except OSError as e: err(f"audit write failed: {e}")
        return entry
    def last_n(self, n=20):
        if not os.path.isfile(self.path): return []
        entries = []
        with open(self.path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line:
                    try: entries.append(json.loads(line))
                    except json.JSONDecodeError: pass
        return entries[-n:]

# === EXPORT ===
class Exporter:
    def __init__(self, d=None):
        self.export_dir = d or DEFAULT_EXPORT_DIR
        os.makedirs(self.export_dir, exist_ok=True)
        self._r = self._h = self._l = None
    def stage(self, label, headers, rows):
        self._l, self._h, self._r = label, headers, rows
    def has_staged(self): return self._r is not None and len(self._r) > 0
    def _gen(self, ext):
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        safe = re.sub(r"[^a-zA-Z0-9_-]", "_", self._l or "export")[:40]
        return os.path.join(self.export_dir, f"{safe}_{ts}.{ext}")
    def to_csv(self, path=None):
        if not self.has_staged(): return None
        path = path or self._gen("csv")
        with open(path, "w", newline="", encoding="utf-8") as f:
            w = csv.writer(f); w.writerow(self._h); w.writerows(self._r)
        return path
    def to_json(self, path=None):
        if not self.has_staged(): return None
        path = path or self._gen("json")
        recs = [{self._h[i]: row[i] if i < len(row) else ""
                 for i in range(len(self._h))} for row in self._r]
        with open(path, "w", encoding="utf-8") as f:
            json.dump({"exported": _utc_now_iso(),
                       "label": self._l, "count": len(recs), "records": recs},
                      f, indent=2, ensure_ascii=False)
        return path
    def staged_as_dict(self):
        if not self.has_staged(): return []
        return [{self._h[i]: row[i] if i < len(row) else ""
                 for i in range(len(self._h))} for row in self._r]
    def clear(self): self._r = self._h = self._l = None

def offer_export(exporter):
    if _json_mode:
        if exporter.has_staged():
            _json_results.append({"label": exporter._l, "records": exporter.staged_as_dict()})
            exporter.clear()
        return
    if not exporter.has_staged(): return
    say(f"\n  {cC(str(len(exporter._r)))} record(s) available.")
    c = ask("  Export? [c]sv / [j]son / [n]o: ", default="n", allow_back=False).lower()
    if c in ("c", "csv"): ok_msg(f"Saved: {exporter.to_csv()}")
    elif c in ("j", "json"): ok_msg(f"Saved: {exporter.to_json()}")
    exporter.clear()

def ask(prompt, default=None, allow_back=True):
    try: val = input(prompt).strip()
    except (EOFError, KeyboardInterrupt): raise UserAbort()
    if allow_back and val.lower() == "b": raise UserAbort()
    return val if val else (default if default is not None else val)

def confirm(prompt):
    return ask(prompt, default="n", allow_back=False).lower() in ("y", "yes")

# === CREDENTIALS ===
# Design: the toolkit owns this file end-to-end. It creates it, secures its
# permissions (chmod 600 / icacls single-user ACL), and writes to it after
# any interactive prompt -- the person never has to touch it, and its path
# is never printed to the console (grep the source if you need it).
_creds_cache = None

def _creds_file_path():
    return os.environ.get("NSX_TOOLKIT_CREDENTIALS_FILE", DEFAULT_CREDS_FILE)

def _secure_file(path):
    """Best-effort lockdown: owner-only on POSIX, single-user ACL on Windows."""
    try:
        if os.name == "nt":
            import subprocess
            user = os.environ.get("USERNAME", "")
            domain_user = f"{os.environ.get('USERDOMAIN','')}\\{user}" if user else None
            subprocess.run(["icacls", path, "/inheritance:r"],
                           capture_output=True, timeout=10)
            if domain_user:
                subprocess.run(["icacls", path, "/grant:r", f"{domain_user}:F"],
                               capture_output=True, timeout=10)
        else:
            os.chmod(path, 0o600)
    except Exception:
        pass  # permission hardening is best-effort; never block on it

def _load_creds_file():
    global _creds_cache
    if _creds_cache is not None: return _creds_cache
    creds = {}; path = _creds_file_path()
    if os.path.isfile(path):
        try:
            with open(path) as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line: continue
                    k, _, v = line.partition("=")
                    creds[k.strip()] = v.strip().strip('"').strip("'")
        except OSError: pass
    _creds_cache = creds; return creds

def _write_creds_file(updates):
    """Merge `updates` (dict of ENV_VAR -> value) into the creds file and
    lock its permissions down. Never prints the path."""
    global _creds_cache
    path = _creds_file_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    existing = dict(_load_creds_file())
    existing.update({k: v for k, v in updates.items() if k})
    with open(path, "w", encoding="utf-8") as f:
        f.write("# Managed by nsx-toolkit -- do not edit by hand.\n")
        f.write("# Use --set-credentials to update entries.\n")
        for k, v in existing.items():
            f.write(f'{k}="{v}"\n')
    _secure_file(path)
    _creds_cache = None  # force reload next resolve

def _try_keyring(var):
    try:
        import keyring; return keyring.get_password("nsx-toolkit", var)
    except Exception: return None

def resolve_secret(var):
    if not var: return None
    return os.environ.get(var) or _load_creds_file().get(var) or _try_keyring(var)

def credentials_for(entry, allow_prompt=True):
    name = entry.get("name", "?")
    u_env, p_env = entry.get("username_env"), entry.get("password_env")
    user, pwd = resolve_secret(u_env), resolve_secret(p_env)
    src = "stored"
    if not (user and pwd):
        if not allow_prompt:
            raise NsxError(
                f"No credentials available for '{name}'. "
                f"Run with --set-credentials to configure them.")
        try:
            if not user: user = input(f"    username for {name}: ").strip()
            if not pwd: pwd = getpass.getpass(f"    password for {name}: ")
        except (EOFError, KeyboardInterrupt): raise UserAbort()
        if not (user and pwd):
            raise NsxError(f"Credentials not provided for '{name}'.")
        # Auto-persist so this is a one-time prompt. Path is never shown.
        _write_creds_file({k: v for k, v in
                           [(u_env, user), (p_env, pwd)] if k})
        src = "prompted"
    if not (user and pwd): raise NsxError(f"Credentials not provided for '{name}'.")
    return user, pwd, src

def force_set_credentials(managers, only=None):
    """--set-credentials : always prompt and overwrite, regardless of what's
    already stored. CLI-only -- never exposed as a menu option."""
    targets = [m for m in managers if not only or m.get("name") in only]
    if not targets:
        err("No matching managers in inventory."); return 2
    say(f"\n  {cB('Updating stored credentials')} "
        f"({len(targets)} manager(s)) ...")
    updated = 0
    for m in targets:
        name = m.get("name", "?")
        u_env, p_env = m.get("username_env"), m.get("password_env")
        if not (u_env or p_env):
            warn(f"{name}: no username_env/password_env in inventory, skipped.")
            continue
        try:
            user = input(f"    username for {name}: ").strip()
            pwd = getpass.getpass(f"    password for {name}: ")
        except (EOFError, KeyboardInterrupt):
            raise UserAbort()
        if not (user and pwd):
            warn(f"{name}: empty input, skipped."); continue
        _write_creds_file({k: v for k, v in
                           [(u_env, user), (p_env, pwd)] if k})
        ok_msg(f"{name}: credentials updated.")
        updated += 1
    say(f"\n  {cC(str(updated))} of {len(targets)} updated.")
    return 0

