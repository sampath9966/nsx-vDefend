def build_parser():
    p = argparse.ArgumentParser(
        prog="nsx-toolkit.py",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(f"{TOOL_NAME} v{VERSION} -- {TOOL_TAGLINE}\n\n"
                     "Run with no arguments for interactive menu."),
        epilog=f"""
inventory.json  (next to script, or --inventory <path>):
  {{"managers":[{{"name":"gm","role":"gm","host":"...","port":443,
   "verify_ssl":false,"username_env":"NSX_GM_USER","password_env":"NSX_GM_PASS"}}]}}

Credentials: the toolkit prompts once and remembers securely on its own --
there is nothing to create or secure by hand. To update stored credentials:
  nsx-toolkit.py --set-credentials
  nsx-toolkit.py --set-credentials --manager gm

bulk tagging CSV:    vm_name,scope,tag,action  (action = add | remove)

examples:
  nsx-toolkit.py --verify
  nsx-toolkit.py --manager gm --groups --contains web-prod
  nsx-toolkit.py --all-lm --vms-by-tag --scope env --tag prod
  nsx-toolkit.py --dashboard --json
  nsx-toolkit.py --bulk-tag changes.csv --dry-run
  nsx-toolkit.py --bulk-tag changes.csv --enable-writes
  nsx-toolkit.py --all-lm --vm-tags cuc --out-csv results.csv
""")
    p.add_argument("--version", action="version",
                   version=f"{TOOL_NAME} v{VERSION} ({VERSION_DATE})")
    p.add_argument("--inventory", default=None)
    p.add_argument("--manager", default=None)
    p.add_argument("--all-lm", action="store_true")
    p.add_argument("--domain", default=DEFAULT_DOMAIN)
    p.add_argument("--groups", action="store_true")
    p.add_argument("--members", action="store_true")
    p.add_argument("--contains", default=None)
    p.add_argument("--vm-tags", metavar="VM", default=None)
    p.add_argument("--vms-by-tag", action="store_true")
    p.add_argument("--scope", default=None)
    p.add_argument("--tag", default=None)
    p.add_argument("--verify", action="store_true")
    p.add_argument("--bulk-tag", metavar="CSV", default=None)
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--enable-writes", action="store_true")
    p.add_argument("--dashboard", action="store_true",
                   help="Show compliance posture dashboard.")
    p.add_argument("--parity", nargs=2, metavar=("STATIC", "DYNAMIC"),
                   help="Compare static vs dynamic group members.")
    p.add_argument("--reverse-lookup", metavar="VM", default=None,
                   help="VM -> groups -> DFW rules impact analysis. "
                        "Group match is member-type agnostic (VM/VIF/IP/"
                        "segment); DFW rules scanned on GM + all LM, "
                        "deduped by rule path.")
    p.add_argument("--change-ticket", metavar="CSV",
                   help="Generate change plan from CSV.")
    p.add_argument("--set-credentials", action="store_true",
                   help="Prompt for and overwrite stored credentials "
                        "for the selected manager(s), then exit. "
                        "Not available from the interactive menu.")
    p.add_argument("--out-csv", metavar="PATH", default=None)
    p.add_argument("--out-json", metavar="PATH", default=None)
    p.add_argument("--json", action="store_true",
                   help="Output structured JSON to stdout.")
    p.add_argument("--no-color", action="store_true",
                   help="Disable color output.")
    return p


# ═══════════════════════════════════════════════════════════════════════════
#  MAIN
# ═══════════════════════════════════════════════════════════════════════════

def main():
    global _color_enabled, _json_mode

    args = build_parser().parse_args()

    if args.no_color:
        _color_enabled = False
    if args.json:
        _json_mode = True
        _color_enabled = False

    os.makedirs(DATA_DIR, exist_ok=True)
    os.makedirs(DEFAULT_EXPORT_DIR, exist_ok=True)

    try:
        managers, inv_path = load_inventory(args.inventory)
    except NsxError as e:
        err(str(e)); return 2

    only = None
    if args.manager:
        only = {args.manager}
        if not any(m.get("name") == args.manager for m in managers):
            err(f"'{args.manager}' not in inventory.")
            return 2
    elif args.all_lm:
        only = {m.get("name") for m in managers
                if (m.get("role") or "").lower() == ROLE_LM}
        if not only:
            err('No "role":"lm" managers.'); return 2

    # --set-credentials is a standalone maintenance action: update, then exit.
    if args.set_credentials:
        return force_set_credentials(managers, only=only)

    audit = AuditLog()
    exporter = Exporter()
    write_enabled = args.enable_writes

    wants_cli = any([args.groups, args.vm_tags, args.vms_by_tag,
                     args.verify, args.bulk_tag, args.dashboard,
                     args.parity, args.change_ticket, args.reverse_lookup])

    banner(inv_path, len(managers), audit.path, write_enabled)

    try:
        sessions = connect_all(managers, only=only, allow_prompt=True)
    except UserAbort:
        err("Credentials required."); return 2
    if not sessions:
        err("No manager authenticated."); return 2

    if not wants_cli:
        try:
            return interactive(sessions, audit, exporter, write_enabled)
        except (KeyboardInterrupt, EOFError, UserAbort):
            say("\n  Bye."); return 0

    # Non-interactive
    try:
        rc = 0
        if args.verify and not act_verify(sessions):
            rc = 1

        if args.groups:
            act_groups(sessions, args.domain, args.contains,
                       show_members=args.members, exporter=exporter)

        lm = [s for s in sessions if s.role == ROLE_LM]

        if args.vm_tags:
            if not lm: err("Need LM."); return 2
            act_vm_tags(lm, args.vm_tags, exporter)

        if args.vms_by_tag:
            if not lm: err("Need LM."); return 2
            if not args.scope and not args.tag:
                err("--vms-by-tag needs --scope/--tag."); return 2
            act_vms_by_tag(lm, args.scope, args.tag, exporter)

        if args.bulk_tag:
            if not lm: err("Need LM."); return 2
            act_bulk_tag(lm, args.bulk_tag, audit, write_enabled,
                         dry_run=args.dry_run)

        if args.dashboard:
            act_dashboard(sessions, exporter)

        if args.parity:
            act_parity(sessions, args.domain, args.parity[0],
                       args.parity[1], exporter)

        if args.reverse_lookup:
            # Always the full session set -- GM + every LM. See
            # act_reverse_lookup's docstring.
            act_reverse_lookup(sessions, args.reverse_lookup,
                               args.domain, exporter)

        if args.change_ticket:
            act_change_ticket(sessions, args.change_ticket, args.domain,
                              audit, exporter)

        # Export
        if args.out_csv and exporter.has_staged():
            p = exporter.to_csv(args.out_csv)
            say(f"  Exported: {p}")
        if args.out_json and exporter.has_staged():
            p = exporter.to_json(args.out_json)
            say(f"  Exported: {p}")

        if _json_mode:
            if exporter.has_staged():
                _json_results.append({
                    "label": exporter._l,
                    "records": exporter.staged_as_dict(),
                })
            json.dump({"tool": TOOL_NAME, "version": VERSION,
                       "timestamp": _utc_now_iso(),
                       "results": _json_results},
                      sys.stdout, indent=2, ensure_ascii=False)
            print()

        return rc

    except UserAbort:
        say("\n  Cancelled."); return 130
    except NsxError as e:
        err(str(e)); return 1
    except KeyboardInterrupt:
        say("\n  Cancelled."); return 130


if __name__ == "__main__":
    sys.exit(main())
