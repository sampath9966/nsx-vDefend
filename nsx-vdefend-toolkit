def connect_all(managers, only=None, allow_prompt=True):
    say(f"\n  {cB('Authenticating')} ...")
    sessions, failed = [], []
    for m in managers:
        name = m.get("name", "?")
        if only and name not in only:
            continue
        try:
            user, pwd, src = credentials_for(m, allow_prompt=allow_prompt)
            sessions.append(Nsx(m, user, pwd))
            say(f"    {cC(name):26s}  credentials {cG(src)}")
        except UserAbort:
            raise
        except NsxError as e:
            failed.append(name)
            err(str(e))
    if failed:
        say(f"    ({cBR(str(len(failed)))} unavailable: {', '.join(failed)})")
    return sessions


