def _c(code, text):
    return f"\033[{code}m{text}\033[0m" if _color_enabled else str(text)
def cG(t):  return _c("32", t)
def cR(t):  return _c("31", t)
def cY(t):  return _c("33", t)
def cC(t):  return _c("36", t)
def cB(t):  return _c("1", t)
def cD(t):  return _c("2", t)
def cBG(t): return _c("1;32", t)
def cBR(t): return _c("1;31", t)
def cBY(t): return _c("1;33", t)
def cBC(t): return _c("1;36", t)

