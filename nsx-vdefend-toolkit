def p_groups(base, domain): return base + PATH_GROUPS.format(domain=domain)
def p_group_members(base, domain, gid): return base + PATH_GROUP_MEMBERS.format(domain=domain, gid=gid)
def p_sec_policies(base, domain): return base + PATH_SEC_POLICIES.format(domain=domain)
def p_sec_rules(base, domain, pid): return base + PATH_SEC_RULES.format(domain=domain, pid=pid)
def p_vm_group_assoc(base): return base + PATH_VM_GROUP_ASSOC

class Nsx:
    def __init__(self, entry, user, pwd):
        self.entry, self.name = entry, entry.get("name", "?")
        self.role = (entry.get("role") or "").lower() or None
        host = entry.get("host")
        if not host: raise NsxError(f"'{self.name}' has no 'host'.")
        self.host, self.base_url = host, f"https://{host}:{entry.get('port', 443)}"
        self.verify, self.timeout = entry.get("verify_ssl", True), entry.get("timeout", 30)
        self.s = requests.Session()
        self.s.auth = HTTPBasicAuth(user, pwd)
        self.s.headers.update({"Content-Type": "application/json", "Accept": "application/json"})
        self._base = entry.get("policy_base")
    def _req(self, method, path, body=None, params=None):
        url = f"{self.base_url}{path}"
        try:
            r = self.s.request(method, url, json=body, params=params,
                               timeout=self.timeout, verify=self.verify)
        except requests.exceptions.RequestException as e:
            raise NsxError(f"[{self.name}] {method} {url} -> {e}")
        if r.status_code >= 400:
            raise NsxError(f"[{self.name}] {method} {url} -> HTTP {r.status_code}: {r.text[:400]}")
        return r.json() if r.text else {}
    def get(self, path, params=None): return self._req("GET", path, params=params)
    def post(self, path, body=None, params=None): return self._req("POST", path, body=body, params=params)
    def get_all(self, path, params=None):
        out, cursor = [], None
        while True:
            p = dict(params or {}); p.setdefault(PARAM_PAGE_SIZE, PAGE_SIZE)
            if cursor: p[PARAM_CURSOR] = cursor
            data = self.get(path, params=p); out.extend(data.get(F_RESULTS, []))
            cursor = data.get(F_CURSOR)
            if not cursor: break
        return out
    def base(self, domain=DEFAULT_DOMAIN, verbose=False):
        if self._base: return self._base
        if self.role != ROLE_GM: self._base = API_BASE_LM; return self._base
        notes = []
        for cand in API_BASE_GM_CANDIDATES:
            try:
                self.get(p_groups(cand, domain), params={PARAM_PAGE_SIZE: 1})
                self._base = cand
                if verbose: say(f"    GM answers on: {cG(cand)}")
                return self._base
            except NsxError as e:
                notes.append(str(e)[:160])
                if verbose: say(f"    {cD('(not ' + cand + ')')}")
        raise NsxError("GM did not answer on any known base.\n" +
                       "\n".join(f"      {n}" for n in notes))

def load_inventory(path=None):
    candidates = [path] if path else [DEFAULT_INVENTORY, os.path.join(os.getcwd(), "inventory.json")]
    for c in candidates:
        if c and os.path.isfile(c):
            try:
                with open(c) as f: data = json.load(f)
            except json.JSONDecodeError as e: raise NsxError(f"Invalid JSON in {c}: {e}")
            mgrs = data.get("managers") or []
            if not mgrs: raise NsxError(f"{c} has no 'managers'.")
            return mgrs, c
    raise NsxError("No inventory file found.")

# === TAG HELPERS ===
def tags_of(obj): return [(t.get(F_TAG_SCOPE, ""), t.get(F_TAG_VALUE, "")) for t in (obj.get(F_TAGS) or [])]
def fmt_tags(pairs):
    if not pairs: return cD("(none)")
    return ", ".join(f"{cC(s)}={t}" if s else t for s, t in sorted(pairs))
def fmt_tags_plain(pairs):
    if not pairs: return "(none)"
    return ", ".join(f"{s}={t}" if s else t for s, t in sorted(pairs))
def validate_tag(scope, value):
    w = []
    if scope and not TAG_FORMAT_RE.match(scope): w.append(f"scope '{scope}' bad format")
    if value and not TAG_FORMAT_RE.match(value): w.append(f"tag '{value}' bad format")
    if scope and scope not in TAXONOMY_ALL_SCOPES: w.append(f"scope '{scope}' not in taxonomy")
    allowed = TAXONOMY_VALUES.get(scope)
    if allowed is not None and value and value not in allowed:
        w.append(f"'{value}' not allowed for '{scope}' ({', '.join(allowed)})")
    return w
def validate_vm_tags(pairs):
    issues = []
    scopes = {s for s, _ in pairs if s}
    for req in TAXONOMY_MANDATORY:
        if req not in scopes: issues.append(f"mandatory scope '{req}' missing")
    for s, t in pairs:
        issues.extend(validate_tag(s, t))
    return (not issues), issues

# === TAG AUTOCOMPLETE ===
def pick_scope():
    say(f"\n    {cB('Scopes')} (* = mandatory):")
    for i, s in enumerate(TAXONOMY_ALL_SCOPES, 1):
        m = cBG("*") if s in TAXONOMY_MANDATORY else " "
        vals = TAXONOMY_VALUES.get(s)
        hint = f"  {cD(', '.join(vals))}" if vals else ""
        say(f"      {i:2d}. {m} {cC(s)}{hint}")
    say(f"       0. {cD('custom')}")
    c = ask("    Scope [# or name]: ", default="")
    if c.isdigit():
        idx = int(c)
        if idx == 0: return ask("    Custom scope: ", default="")
        if 1 <= idx <= len(TAXONOMY_ALL_SCOPES): return TAXONOMY_ALL_SCOPES[idx - 1]
    return c.lower().strip()

def pick_value(scope):
    allowed = TAXONOMY_VALUES.get(scope)
    if not allowed: return ask("    Tag value: ")
    say(f"\n    {cB('Values for')} {cC(scope)}:")
    for i, v in enumerate(allowed, 1): say(f"      {i}. {v}")
    say(f"      0. {cD('custom')}")
    c = ask("    Value [# or name]: ", default="")
    if c.isdigit():
        idx = int(c)
        if idx == 0: return ask("    Custom value: ")
        if 1 <= idx <= len(allowed): return allowed[idx - 1]
    return c.lower().strip()

# === GROUP CRITERIA ===
def describe_expression(expr):
    if not expr: return [cD("(no criteria)")]
    lines = []
    for item in expr:
        rt = item.get(RT)
        if rt == RT_CONJUNCTION: lines.append(f"  {cB(item.get(F_CONJ_OP, '?'))}")
        elif rt == RT_CONDITION:
            key, op, val = item.get(F_KEY, "?"), item.get(F_OPERATOR, "?"), item.get(F_VALUE, "")
            mt = item.get(F_MEMBER_TYPE, "")
            if key == KEY_TAG and TAG_SCOPE_SEPARATOR in str(val):
                s, _, t = str(val).partition(TAG_SCOPE_SEPARATOR)
                lines.append(f"  {mt} Tag {op} {cC(s)}={cG(t)}")
            else: lines.append(f"  {mt} {key} {op} '{val}'")
        elif rt == RT_NESTED:
            lines.append("  ( nested:")
            for sub in describe_expression(item.get(F_EXPRESSIONS, [])): lines.append(f"  {sub}")
            lines.append("  )")
        elif rt == RT_IPADDRESS:
            ips = item.get(F_IP_ADDRESSES, [])
            lines.append(f"  IPs ({len(ips)}): {', '.join(map(str, ips[:8]))}" + (" ..." if len(ips) > 8 else ""))
        elif rt == RT_PATHEXPR:
            paths = item.get(F_PATHS, [])
            lines.append(f"  Paths ({len(paths)}):")
            for p in paths[:10]: lines.append(f"    {p}")
        else: lines.append(f"  {rt or 'unknown'}: {json.dumps(item)[:160]}")
    return lines

# === VM LOOKUP ===
def find_vms(nsx, needle):
    try:
        hits = nsx.get(PATH_FABRIC_VMS, params={PARAM_DISPLAY_NAME: needle}).get(F_RESULTS, [])
        if hits: return hits
    except NsxError: pass
    n = (needle or "").lower()
    return [v for v in nsx.get_all(PATH_FABRIC_VMS) if n in str(v.get(F_DISPLAY_NAME, "")).lower()]

def write_tags(nsx, vm, pairs, audit, old_pairs):
    ext = vm.get(F_EXTERNAL_ID)
    if not ext: raise NsxError("VM has no external_id.")
    nsx.post(PATH_FABRIC_VMS, body={F_EXTERNAL_ID: ext,
             F_TAGS: [{F_TAG_SCOPE: s, F_TAG_VALUE: t} for s, t in pairs]},
             params={PARAM_ACTION: ACTION_UPDATE_TAGS})
    audit.log("update_tags", nsx.name, vm.get(F_DISPLAY_NAME, "?"), ext, old_pairs, pairs)

def _get_all_vms(nsx): return nsx.get_all(PATH_FABRIC_VMS)

# === ACTIONS ===
def act_groups(sessions, domain, needle, show_members, exporter):
    eh, er = ["manager","group_id","display_name","path","criteria","members"], []
    for nsx in sessions:
        try: base = nsx.base(domain)
        except NsxError as e: err(str(e)); continue
        section(f"{nsx.name}  [{ROLE_LABEL.get(nsx.role,'?')}]")
        with Spinner(f"Fetching groups from {nsx.name}"):
            try: groups = nsx.get_all(p_groups(base, domain))
            except NsxError as e: err(str(e)); continue
        say(f"  {len(groups)} group(s).")
        if needle:
            n = needle.lower()
            groups = [g for g in groups if n in str(g.get(F_DISPLAY_NAME,"")).lower() or n in str(g.get(F_ID,"")).lower()]
            say(f"  {cC(str(len(groups)))} match '{needle}'.")
        for g in sorted(groups, key=lambda x: str(x.get(F_DISPLAY_NAME,"")).lower()):
            gid, dname = g.get(F_ID, "?"), g.get(F_DISPLAY_NAME, g.get(F_ID, "?"))
            hr()
            say(f"  Group        : {cB(dname)}")
            if gid != dname: say(f"  id           : {gid}   {cBY('[id != name]')}")
            else: say(f"  id           : {gid}")
            say(f"  path         : {cD(g.get(F_PATH, '?'))}")
            if g.get(F_DESCRIPTION): say(f"  description  : {g[F_DESCRIPTION]}")
            say("  criteria     :")
            cl = describe_expression(g.get(F_EXPRESSION))
            for line in cl: say(f"    {line}")
            mc = ""
            if show_members:
                try:
                    vms = nsx.get_all(p_group_members(base, domain, gid)); mc = str(len(vms))
                    say(f"  VM members ({cC(mc)}):")
                    for vm in vms[:30]: say(f"    {vm.get(F_DISPLAY_NAME, vm.get(F_ID,'?'))}")
                    if len(vms) > 30: say(f"    {cD(f'... +{len(vms)-30} more')}")
                except NsxError as e: say(f"  VM members: {cR('error')} ({e})"); mc = "error"
            cs = "; ".join(re.sub(r"\033\[[0-9;]*m", "", l).strip() for l in cl[:3])
            er.append([nsx.name, gid, dname, g.get(F_PATH, ""), cs, mc])
    hr(); exporter.stage("groups", eh, er)

def act_vm_tags(sessions, needle, exporter):
    eh, er, total = ["manager","vm_name","external_id","power_state","tag_scope","tag_value"], [], 0
    for nsx in sessions:
        section(f"{nsx.name}  [{ROLE_LABEL.get(nsx.role,'?')}]")
        with Spinner(f"Searching VMs on {nsx.name}"):
            try: matches = find_vms(nsx, needle)
            except NsxError as e: err(str(e)); continue
        if not matches: say(f"  No VM matching '{needle}'"); continue
        total += len(matches)
        for vm in sorted(matches, key=lambda v: str(v.get(F_DISPLAY_NAME,"")).lower())[:50]:
            vn, ext, pwr = vm.get(F_DISPLAY_NAME,"?"), vm.get(F_EXTERNAL_ID,"?"), vm.get(F_POWER_STATE,"")
            pairs = tags_of(vm); hr()
            say(f"  VM           : {cB(vn)}")
            say(f"  external_id  : {cD(ext)}")
            if pwr: say(f"  power_state  : {cG(pwr) if 'ON' in pwr else cY(pwr)}")
            say(f"  tags ({len(pairs)})    :")
            if pairs:
                for s, t in sorted(pairs):
                    say(f"    {cC(s):30s} = {t}"); er.append([nsx.name, vn, ext, pwr, s, t])
                ok, iss = validate_vm_tags(pairs)
                say(f"  taxonomy     : {cBG('OK') if ok else cBY(f'{len(iss)} issue(s)')}")
                if not ok:
                    for i in iss[:5]: warn(i)
            else: say(f"    {cD('(none)')}"); er.append([nsx.name, vn, ext, pwr, "", ""])
    hr(); say(f"  {cC(str(total))} VM(s) across {len(sessions)} manager(s).")
    exporter.stage("vm_tags", eh, er)

def act_vms_by_tag(sessions, scope, tag, exporter):
    crit = " and ".join(x for x in [f"scope='{scope}'" if scope else "", f"tag='{tag}'" if tag else ""] if x)
    eh, er, total = ["manager","vm_name","external_id","all_tags"], [], 0
    lm = [s for s in sessions if s.role == ROLE_LM]
    all_vms = parallel_run(lm, _get_all_vms, label="Scanning inventories")
    for nsx in lm:
        section(nsx.name)
        vms = all_vms.get(nsx.name)
        if isinstance(vms, Exception): err(str(vms)); continue
        if not vms: continue
        def hit(vm):
            for s, t in tags_of(vm):
                if scope and s.lower() != scope.lower(): continue
                if tag and t.lower() != tag.lower(): continue
                return True
            return False
        matches = [v for v in vms if hit(v)]; total += len(matches)
        say(f"  {cC(str(len(matches)))} of {len(vms)} VM(s) carry {crit}")
        for vm in sorted(matches, key=lambda v: str(v.get(F_DISPLAY_NAME,"")).lower()):
            vn = vm.get(F_DISPLAY_NAME, "?")
            say(f"    {vn:45s} {fmt_tags(tags_of(vm))}")
            er.append([nsx.name, vn, vm.get(F_EXTERNAL_ID,""), fmt_tags_plain(tags_of(vm))])
    hr(); say(f"  {cC(str(total))} VM(s) across {len(lm)} LM(s).")
    exporter.stage("vms_by_tag", eh, er)

def act_manage_tags(sessions, needle, audit, we):
    if not we: say(f"  {cBY('Writes disabled')}. Toggle with menu 12 or --enable-writes."); return
    found = []
    for nsx in sessions:
        try:
            for vm in find_vms(nsx, needle): found.append((nsx, vm))
        except NsxError as e: err(str(e))
    if not found: say(f"  No VM matching '{needle}'."); return
    if len(found) == 1: nsx, vm = found[0]
    else:
        say(f"\n  {len(found)} matches:")
        for i, (n, v) in enumerate(found[:40], 1):
            say(f"    {i}. [{cC(n.name)}] {v.get(F_DISPLAY_NAME,'?'):40s} {fmt_tags(tags_of(v))}")
        say("    b. back")
        while True:
            c = ask("  Which VM? ")
            if c.isdigit() and 1 <= int(c) <= min(len(found), 40): nsx, vm = found[int(c)-1]; break
            say("    Invalid.")
    while True:
        cur = next((v for v in find_vms(nsx, vm.get(F_DISPLAY_NAME,"")) if v.get(F_EXTERNAL_ID) == vm.get(F_EXTERNAL_ID)), vm)
        pairs = sorted(tags_of(cur)); hr()
        say(f"  VM  : {cB(cur.get(F_DISPLAY_NAME,'?'))}   [{cC(nsx.name)}]")
        say(f"  tags ({len(pairs)}):")
        for i, (s, t) in enumerate(pairs, 1):
            flag = f"  {cBY('!!')}" if validate_tag(s, t) else ""
            say(f"    {i:2d}. {cC(s):30s} = {t}{flag}")
        if not pairs: say(f"      {cD('(none)')}")
        hr(); say(f"    1. {cG('Add')}"); say(f"    2. {cR('Remove')}"); say("    b. Back")
        c = ask("  Choice: ", allow_back=False).lower()
        if c == "b": return
        elif c == "1":
            scope = pick_scope()
            if not scope: say("    Scope required."); continue
            name = pick_value(scope)
            if not name: say("    Value required."); continue
            ws = validate_tag(scope, name)
            if ws:
                for w in ws: warn(w)
                if not confirm("    Proceed? [y/N]: "): continue
            if (scope, name) in pairs: say("    Already has it."); continue
            new = pairs + [(scope, name)]
            say(f"\n    Result ({len(new)} tags):")
            for s, t in sorted(new):
                say(f"      {cC(s):30s} = {t}" + (f"  {cBG('<-- NEW')}" if (s,t)==(scope,name) else ""))
            if not confirm("    Apply? [y/N]: "): say("    Cancelled."); continue
            try: write_tags(nsx, cur, new, audit, pairs); ok_msg("Applied.")
            except NsxError as e: err(str(e))
        elif c == "2":
            if not pairs: say("    No tags."); continue
            sel = ask("    Tag # to remove: ")
            if not sel.isdigit() or not (1 <= int(sel) <= len(pairs)): say("    Invalid."); continue
            victim = pairs[int(sel)-1]; new = [p for p in pairs if p != victim]
            say(f"\n    Removing: {cR(f'{victim[0]}={victim[1]}')}")
            say(f"    {cBY('NOTE')}: may affect dynamic groups and DFW rules.")
            if not confirm("    Apply? [y/N]: "): continue
            try: write_tags(nsx, cur, new, audit, pairs); ok_msg("Removed.")
            except NsxError as e: err(str(e))

def act_bulk_tag(sessions, csv_path, audit, we, dry_run=False):
    if not we and not dry_run: say(f"  {cBY('Writes disabled')}."); return
    if not os.path.isfile(csv_path): err(f"Not found: {csv_path}"); return
    with open(csv_path, newline="", encoding="utf-8") as f: rows = list(csv.DictReader(f))
    if not rows: err("CSV empty."); return
    missing = {"vm_name","scope","tag","action"} - set(rows[0].keys())
    if missing: err(f"CSV missing: {', '.join(missing)}."); return
    by_vm = {}
    for row in rows: by_vm.setdefault(row["vm_name"].strip(), []).append(row)
    label = cBY("DRY RUN") if dry_run else cBG("APPLYING")
    say(f"\n  {label} -- {len(rows)} ops on {len(by_vm)} VM(s)"); hr()
    res = {"applied": 0, "skipped": 0, "failed": 0}
    for vm_name, ops in sorted(by_vm.items()):
        found = None
        for nsx in sessions:
            try:
                hits = find_vms(nsx, vm_name)
                exact = [h for h in hits if h.get(F_DISPLAY_NAME,"").lower() == vm_name.lower()]
                if exact: found = (nsx, exact[0]); break
            except NsxError: continue
        if not found:
            say(f"  {vm_name:45s}  {cR('NOT FOUND')}"); res["skipped"] += len(ops); continue
        nsx, vm = found; cur = sorted(tags_of(vm)); new = list(cur)
        for op in ops:
            s, t, a = op["scope"].strip(), op["tag"].strip(), op["action"].strip().lower()
            if a == "add" and (s, t) not in new: new.append((s, t))
            elif a == "remove": new = [p for p in new if p != (s, t)]
        if sorted(new) == sorted(cur):
            say(f"  {vm_name:45s}  {cD('no change')}"); res["skipped"] += len(ops); continue
        added = [p for p in new if p not in cur]; removed = [p for p in cur if p not in new]
        ch = []; 
        if added: ch.append(cG(f"+{len(added)}"))
        if removed: ch.append(cR(f"-{len(removed)}"))
        if dry_run:
            say(f"  {vm_name:45s}  [{cC(nsx.name)}]  would: {', '.join(ch)}")
            for s, t in added: say(f"      {cG(f'+ {s}={t}')}")
            for s, t in removed: say(f"      {cR(f'- {s}={t}')}")
            res["applied"] += len(ops)
        else:
            try:
                write_tags(nsx, vm, new, audit, cur)
                say(f"  {vm_name:45s}  [{cC(nsx.name)}]  applied: {', '.join(ch)}"); res["applied"] += len(ops)
            except NsxError as e:
                say(f"  {vm_name:45s}  {cBR('FAILED')}"); res["failed"] += len(ops)
    hr(); say(f"  Complete: {cG(str(res['applied']))} applied, {cY(str(res['skipped']))} skipped, {cR(str(res['failed']))} failed.")

def act_reverse_lookup(all_sessions, needle, domain, exporter):
    """VM -> groups -> DFW rules impact analysis.

    GROUP MEMBERSHIP: uses NSX's own reverse-association endpoint
    (virtual-machine-group-associations) instead of sweeping every group's
    /members/virtual-machines sub-resource. That sub-resource only returns
    results for groups whose criteria resolves to the VirtualMachine member
    type -- groups matched on VIF, IPAddress, Segment, or SegmentPort
    criteria silently come back empty there even though the VM is an
    effective member. The association endpoint is member-type agnostic:
    it's the same index NSX's own Groups search UI reads, so results match
    what you see there. Queried on the VM's home LM (tags/VMs are LM-local),
    with a best-effort supplementary query on any connected GM.

    DFW RULES: GM-authored security policies are realized read-only on
    every LM registered beneath it, so an LM's own rule listing contains
    both its native rules AND a copy of every GM rule. Scanned across GM +
    all LMs, that means each GM rule would otherwise be reported once per
    LM (once per site, up to 8x). Rules are deduped globally by their NSX
    'path' -- first-seen wins, GM sessions are scanned before LM sessions,
    so a GM-origin rule is always attributed to 'GM' exactly once and never
    re-listed per LM. Rules with no GM session connected (or genuinely
    LM-native rules) still get counted, tagged with the appropriate origin.
    """
    eh = ["vm", "manager", "manager_role", "group_id", "group_name",
          "group_origin", "policy", "rule", "rule_origin", "action",
          "direction"]
    er = []

    gm_sessions = [s for s in all_sessions if s.role == ROLE_GM]
    lm_sessions = [s for s in all_sessions if s.role == ROLE_LM]

    # Tags/VMs are LM-local objects -- find the VM on whichever LM has it.
    found_vm = None
    for nsx in lm_sessions:
        try:
            hits = find_vms(nsx, needle)
            if hits:
                found_vm = (nsx, hits[0]); break
        except NsxError:
            continue
    if not found_vm:
        say(f"  No VM matching '{needle}' on any Local Manager."); return

    nsx_lm, vm = found_vm
    vname = vm.get(F_DISPLAY_NAME, "?")
    ext_id = vm.get(F_EXTERNAL_ID)
    say(f"\n  VM      : {cB(vname)}")
    say(f"  Found on: {cC(nsx_lm.name)}  (Local Manager)")
    say(f"  tags    : {fmt_tags(tags_of(vm))}")
    if not ext_id:
        say(f"  {cBR('VM has no external_id')} -- cannot resolve group "
            f"associations."); return

    # --- Group membership: reverse-association lookup, any member type ---
    section("Group Membership (any member type)")
    matched = {}   # group_id -> (path, display_name, origin)
    try:
        base = nsx_lm.base(domain)
    except NsxError as e:
        err(str(e)); return
    with Spinner(f"Association lookup on {nsx_lm.name}"):
        try:
            assocs = nsx_lm.get_all(p_vm_group_assoc(base),
                                    params={PARAM_VM_EXTERNAL_ID: ext_id})
        except NsxError as e:
            err(f"association lookup on {nsx_lm.name} failed: {e}")
            assocs = []
    for a in assocs:
        gpath = a.get(F_PATH, "")
        gid = a.get(F_TARGET_ID) or (gpath.rsplit("/", 1)[-1] if gpath else "?")
        gname = a.get(F_TARGET_DISPLAY_NAME, gid)
        matched[gid] = (gpath, gname, origin_of_path(gpath))

    # Best-effort supplementary check on any connected GM -- catches the
    # rare case of a Global Group not yet realized onto this specific LM.
    # Non-fatal: GM doesn't hold VM inventory, so this may simply 404.
    for nsx_gm in gm_sessions:
        try:
            gbase = nsx_gm.base(domain)
            g_assocs = nsx_gm.get_all(p_vm_group_assoc(gbase),
                                      params={PARAM_VM_EXTERNAL_ID: ext_id})
        except NsxError:
            continue
        for a in g_assocs:
            gpath = a.get(F_PATH, "")
            gid = a.get(F_TARGET_ID) or (gpath.rsplit("/", 1)[-1] if gpath else "?")
            if gid in matched:
                continue
            gname = a.get(F_TARGET_DISPLAY_NAME, gid)
            matched[gid] = (gpath, gname, origin_of_path(gpath))

    if not matched:
        say(f"  {cD('Not a member of any group on any manager.')}")
        return
    for gid, (gpath, gname, origin) in sorted(matched.items(),
                                              key=lambda kv: kv[1][1].lower()):
        tag = cC("GM") if origin == "GM" else cD("LM")
        say(f"    [{tag}]  {cB(gname)}  {cD('id=' + gid)}")

    # Build the set of path/id strings DFW rules might reference.
    group_paths = {gp for gp, _, _ in matched.values() if gp} | set(matched.keys())
    group_lookup = {gid: gname for gid, (_, gname, _) in matched.items()}

    # --- DFW rules: GM scanned first, then LM, deduped by rule path ---
    section("DFW Rules Referencing These Groups")
    say(f"  Scanning {len(gm_sessions)} GM + {len(lm_sessions)} LM "
        f"({cD('deduped by rule path')}) ...")
    seen_rule_paths, hit_count = set(), 0
    for nsx in gm_sessions + lm_sessions:
        try:
            base = nsx.base(domain)
        except NsxError:
            continue
        with Spinner(f"Policies on {nsx.name}"):
            try:
                pols = nsx.get_all(p_sec_policies(base, domain))
            except NsxError:
                continue
        for pol in pols:
            pid = pol.get(F_ID, "?")
            try:
                rules = nsx.get_all(p_sec_rules(base, domain, pid))
            except NsxError:
                continue
            for rule in rules:
                rpath = rule.get(F_PATH, "")
                refs = set(rule.get(F_SOURCE_GROUPS, [])
                           + rule.get(F_DEST_GROUPS, [])
                           + rule.get(F_SCOPE, []))
                hits = refs & group_paths
                if not hits:
                    continue
                if rpath:
                    if rpath in seen_rule_paths:
                        continue   # already reported via GM (or an earlier
                                   # LM) scan -- this is the dedup
                    seen_rule_paths.add(rpath)
                hit_count += 1
                dirs = []
                if set(rule.get(F_SOURCE_GROUPS, [])) & group_paths:
                    dirs.append("source")
                if set(rule.get(F_DEST_GROUPS, [])) & group_paths:
                    dirs.append("dest")
                if set(rule.get(F_SCOPE, [])) & group_paths:
                    dirs.append("applied_to")
                act = rule.get(F_ACTION_FIELD, "?")
                ac = cG if act == "ALLOW" else cR
                role_lbl = ROLE_LABEL.get(nsx.role, "?")
                if nsx.role == ROLE_GM:
                    rule_origin = "GM"
                else:
                    rule_origin = origin_of_path(rpath)
                    if rule_origin == "GM":
                        rule_origin = "GM (via LM)" if not gm_sessions else "GM"
                say(f"    [{cC(nsx.name)} / {cD(role_lbl)} / "
                    f"{cD(rule_origin)}]  "
                    f"{cB(pol.get(F_DISPLAY_NAME, pid))} / "
                    f"{rule.get(F_DISPLAY_NAME, '?')}"
                    f"   {ac(act)}   {cC(', '.join(dirs))}")
                for gpath in hits:
                    gi = gpath.rsplit("/", 1)[-1] if "/" in gpath else gpath
                    _, _, gorigin = matched.get(gi, (None, None, "?"))
                    er.append([vname, nsx.name, role_lbl, gi,
                              group_lookup.get(gi, gi), gorigin, pid,
                              rule.get(F_ID, "?"), rule_origin, act,
                              ", ".join(dirs)])
    if hit_count == 0:
        say(f"  {cG('No DFW rules')} reference these groups on any manager.")
    hr()
    exporter.stage("reverse_lookup", eh, er)

def act_dashboard(sessions, exporter):
    lm = [s for s in sessions if s.role == ROLE_LM]
    if not lm: say("  No LMs."); return
    section(f"COMPLIANCE DASHBOARD    {datetime.datetime.now().strftime('%Y-%m-%d %H:%M')}")
    all_v = parallel_run(lm, _get_all_vms, label="Fetching VM inventories")
    vms = []
    for name, result in all_v.items():
        if isinstance(result, Exception): err(f"{name}: {result}"); continue
        for vm in (result or []): vm["_mgr"] = name; vms.append(vm)
    total = len(vms)
    if total == 0: say("  No VMs found."); return
    sc = {s: 0 for s in TAXONOMY_MANDATORY}; untagged = full = partial = 0
    eh, er = ["vm_name","manager","tag_count","mandatory_present","missing","status"], []
    for vm in vms:
        pairs = tags_of(vm); scopes = {s for s, _ in pairs if s}
        pm = [s for s in TAXONOMY_MANDATORY if s in scopes]
        miss = [s for s in TAXONOMY_MANDATORY if s not in scopes]
        if not pairs: untagged += 1; st = "untagged"
        elif len(pm) == len(TAXONOMY_MANDATORY): full += 1; st = "complete"
        else: partial += 1; st = "partial"
        for s in TAXONOMY_MANDATORY:
            if s in scopes: sc[s] += 1
        er.append([vm.get(F_DISPLAY_NAME,"?"), vm.get("_mgr","?"), str(len(pairs)),
                   str(len(pm)), ", ".join(miss) or "none", st])
    say(f"\n  {cB('Scope Coverage')} ({total} VMs)")
    say("")
    table(["Scope", "Coverage", "Progress"],
          [[cC(s), f"{sc[s]}/{total}", progress_bar(sc[s], total)] for s in TAXONOMY_MANDATORY], indent=4)
    say(f"\n  {cB('Summary')}"); hr()
    say(f"    Total VMs              : {cB(str(total))}")
    say(f"    Fully tagged (6/6)     : {cBG(str(full))} ({int(100*full/total)}%)")
    say(f"    Partially tagged       : {cBY(str(partial))} ({int(100*partial/total)}%)")
    say(f"    Untagged               : {cBR(str(untagged))} ({int(100*untagged/total)}%)")
    say(f"    Migration progress     : {progress_bar(full, total)}")
    say(f"\n  {cB('Per-Manager')}")
    mr = []
    for nsx in lm:
        mv = [v for v in vms if v.get("_mgr") == nsx.name]
        mt = len(mv)
        mf = sum(1 for v in mv if len({s for s, _ in tags_of(v) if s} & set(TAXONOMY_MANDATORY)) == len(TAXONOMY_MANDATORY))
        mu = sum(1 for v in mv if not tags_of(v))
        mr.append([cC(nsx.name), str(mt), cG(str(mf)), cR(str(mu)), progress_bar(mf, mt)])
    table(["Manager", "VMs", "Complete", "Untagged", "Progress"], mr, indent=4)
    hr(); exporter.stage("dashboard", eh, er)

def act_parity(sessions, domain, sn, dn, exporter):
    eh, er = ["vm_name","in_static","in_dynamic","status"], []
    def find_g(name):
        for nsx in sessions:
            try:
                base = nsx.base(domain); groups = nsx.get_all(p_groups(base, domain))
            except NsxError: continue
            for g in groups:
                if g.get(F_DISPLAY_NAME,"").lower() == name.lower() or g.get(F_ID,"").lower() == name.lower():
                    return nsx, g, base
        return None, None, None
    ns, gs, bs = find_g(sn)
    if not gs: err(f"Static group '{sn}' not found."); return
    nd, gd, bd = find_g(dn)
    if not gd: err(f"Dynamic group '{dn}' not found."); return
    section("Parity Validation")
    say(f"  Static  : {cB(gs.get(F_DISPLAY_NAME,'?'))} on {cC(ns.name)}")
    say(f"  Dynamic : {cB(gd.get(F_DISPLAY_NAME,'?'))} on {cC(nd.name)}")
    with Spinner("Fetching members"):
        try: sm = ns.get_all(p_group_members(bs, domain, gs.get(F_ID)))
        except NsxError as e: err(str(e)); return
        try: dm = nd.get_all(p_group_members(bd, domain, gd.get(F_ID)))
        except NsxError as e: err(str(e)); return
    sn_set = {m.get(F_DISPLAY_NAME,"").lower(): m for m in sm}
    dn_set = {m.get(F_DISPLAY_NAME,"").lower(): m for m in dm}
    only_s = sorted(set(sn_set) - set(dn_set)); only_d = sorted(set(dn_set) - set(sn_set))
    both = sorted(set(sn_set) & set(dn_set))
    say(f"\n  Static: {cC(str(len(sn_set)))}  Dynamic: {cC(str(len(dn_set)))}  Both: {cBG(str(len(both)))}")
    say(f"  Only static: {cBR(str(len(only_s)))} (need migration)  Only dynamic: {cBY(str(len(only_d)))} (unexpected)")
    if only_s:
        say(f"\n  {cBR('Need migration')}:")
        for n in only_s[:30]:
            say(f"    {cR('x')} {sn_set[n].get(F_DISPLAY_NAME, n)}")
            er.append([sn_set[n].get(F_DISPLAY_NAME, n), "yes", "no", "needs_migration"])
    if only_d:
        say(f"\n  {cBY('Unexpected')}:")
        for n in only_d[:30]:
            say(f"    {cY('?')} {dn_set[n].get(F_DISPLAY_NAME, n)}")
            er.append([dn_set[n].get(F_DISPLAY_NAME, n), "no", "yes", "unexpected"])
    for n in both: er.append([sn_set[n].get(F_DISPLAY_NAME, n), "yes", "yes", "migrated"])
    say(f"\n  Parity: {progress_bar(len(both), len(sn_set))}"); hr()
    exporter.stage("parity", eh, er)

def act_change_ticket(sessions, csv_path, domain, audit, exporter):
    if not os.path.isfile(csv_path): err(f"Not found: {csv_path}"); return
    with open(csv_path, newline="", encoding="utf-8") as f: rows = list(csv.DictReader(f))
    if not rows: err("Empty CSV."); return
    by_vm = {}
    for row in rows: by_vm.setdefault(row.get("vm_name","").strip(), []).append(row)
    adds = sum(1 for r in rows if r.get("action","").strip().lower() == "add")
    removes = sum(1 for r in rows if r.get("action","").strip().lower() == "remove")
    ts = _utc_now_stamp()
    user = os.environ.get("USERNAME") or os.environ.get("USER", "unknown")
    lines = ["=" * 70, f"  CHANGE PLAN: Tag Migration Batch", "=" * 70,
             f"  Prepared by : {user}", f"  Date        : {ts}", f"  Source      : {csv_path}",
             f"  Host        : {platform.node()}", "",
             "  SCOPE", "  " + "-" * 40,
             f"  VMs affected   : {len(by_vm)}", f"  Tags to add    : {adds}",
             f"  Tags to remove : {removes}", f"  Total ops      : {len(rows)}", "",
             "  CHANGES BY VM", "  " + "-" * 40]
    for vn, ops in sorted(by_vm.items()):
        lines.append(f"  {vn}")
        for op in ops:
            sym = "+" if op.get("action","").strip().lower() == "add" else "-"
            lines.append(f"    {sym} {op.get('scope','').strip()}={op.get('tag','').strip()}")
        lines.append("")
    lines.extend(["  ROLLBACK", "  " + "-" * 40,
                  "  Use audit log undo (menu 11) or --bulk-tag <rollback.csv>", "",
                  "  PRE-CHANGE CHECKLIST", "  " + "-" * 40,
                  "  1. --verify all managers reachable",
                  "  2. --bulk-tag <file> --dry-run to preview",
                  "  3. Confirm no active maintenance windows", "", "=" * 70])
    tsf = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    out_path = os.path.join(DEFAULT_EXPORT_DIR, f"change_plan_{tsf}.txt")
    os.makedirs(DEFAULT_EXPORT_DIR, exist_ok=True)
    with open(out_path, "w", encoding="utf-8") as f: f.write("\n".join(lines))
    for line in lines:
        if line.startswith("=" * 10): say(cBC(line))
        elif "CHANGE PLAN" in line: say(f"  {cB(line.strip())}")
        elif line.strip().startswith("+"): say(cG(line))
        elif line.strip().startswith("-") and "=" in line: say(cR(line))
        else: say(line)
    ok_msg(f"Saved: {out_path}")

def act_verify(sessions):
    ok = True
    for nsx in sessions:
        section(f"{nsx.name}  [{ROLE_LABEL.get(nsx.role,'?')}]  {nsx.base_url}")
        if nsx.role == ROLE_GM:
            try: base = nsx.base(verbose=True)
            except NsxError as e: err(str(e)); ok = False; continue
            checks = [("groups", p_groups(base, DEFAULT_DOMAIN)),
                      ("security-policies", p_sec_policies(base, DEFAULT_DOMAIN))]
        elif nsx.role == ROLE_LM:
            base = nsx.base()
            checks = [("groups", p_groups(base, DEFAULT_DOMAIN)),
                      ("security-policies", p_sec_policies(base, DEFAULT_DOMAIN)),
                      ("VM inventory", PATH_FABRIC_VMS)]
        else: say(f'  {cBR("no role")}'); ok = False; continue
        for label, path in checks:
            try:
                d = nsx.get(path, params={PARAM_PAGE_SIZE: 1})
                n = d.get(F_RESULT_COUNT, len(d.get(F_RESULTS, [])))
                say(f"  {cBG('OK')}    {label:22s}  {n} item(s)")
            except NsxError as e: say(f"  {cBR('FAIL')}  {label:22s}  {str(e)[:120]}"); ok = False
    hr(); say(f"  {'All ' + cBG('OK') if ok else cBR('Failures detected')}."); return ok

def act_audit_log(audit, sessions, we):
    entries = audit.last_n(20)
    if not entries: say("  Audit log empty."); return
    say(f"\n  Last {cC(str(len(entries)))} entries:"); hr()
    for i, e in enumerate(entries, 1):
        before = [(t.get("scope",""), t.get("tag","")) for t in e.get("tags_before", [])]
        after = [(t.get("scope",""), t.get("tag","")) for t in e.get("tags_after", [])]
        added = [p for p in after if p not in before]; removed = [p for p in before if p not in after]
        say(f"  {cD(str(i)+'.'):5s} {cD(e.get('timestamp','?')[:19])}  "
            f"{e.get('vm_display_name','?'):30s}  [{cC(e.get('manager','?'))}]")
        if added: say(f"        {cG(f'+ {fmt_tags_plain(added)}')}")
        if removed: say(f"        {cR(f'- {fmt_tags_plain(removed)}')}")
    if not we: say(f"\n  {cBY('Undo needs write mode')}."); return
    hr(); c = ask("  Undo entry # (or b): ")
    if not c.isdigit() or not (1 <= int(c) <= len(entries)): say("  Cancelled."); return
    t = entries[int(c)-1]
    bp = [(x.get("scope",""), x.get("tag","")) for x in t.get("tags_before", [])]
    vn, mn, ext = t.get("vm_display_name","?"), t.get("manager","?"), t.get("vm_external_id","?")
    say(f"\n  Restore '{cB(vn)}' on [{cC(mn)}]")
    if not confirm("  Apply undo? [y/N]: "): say("  Cancelled."); return
    nsx = next((s for s in sessions if s.name == mn), None)
    if not nsx: err(f"Manager '{mn}' not in session."); return
    try:
        hits = find_vms(nsx, vn); vm = next((v for v in hits if v.get(F_EXTERNAL_ID) == ext), None)
    except NsxError as e: err(str(e)); return
    if not vm: err(f"VM not found."); return
    try: write_tags(nsx, vm, bp, audit, tags_of(vm)); ok_msg("Undo applied.")
    except NsxError as e: err(str(e))

def select_managers(all_s, allow_roles, allow_all=False, label=""):
    pool = [s for s in all_s if s.role in allow_roles]
    if not pool: say(f"\n  No managers available."); return []
    if len(pool) == 1: return pool  # nothing to choose between
    say(f"\n  Target for {cB(label)}:")
    for i, s in enumerate(pool, 1):
        say(f"    {i}. {cC(s.name):26s}  {s.host:30s}  {cD(ROLE_LABEL.get(s.role,'?'))}")
    if allow_all and len(pool) > 1:
        note = "  (tags span LMs)" if allow_roles == (ROLE_LM,) else ""
        say(f"    a. ALL ({len(pool)}){note}")
    say("    b. back")
    while True:
        c = ask("  Choice: ").lower()
        if allow_all and c == "a": return pool
        if c.isdigit() and 1 <= int(c) <= len(pool): return [pool[int(c)-1]]
        say("    Invalid.")

# ═══════════════════════════════════════════════════════════════════════════
#  INTERACTIVE MENU
#  Design: the full menu prints ONCE. After that, only a compact one-line
#  prompt is shown so action output stays visible right above the next
#  prompt instead of being pushed off-screen by a re-printed menu ('m'
#  brings the full menu back on demand).
# ═══════════════════════════════════════════════════════════════════════════

def _menu_text(mode_str):
    h = cBC("=" * W)
    d = cD("-" * 42)
    return f"""
{h}
  {cB('GROUPS')}   {cD('(Global Manager + Local Managers)')}
  {d}
    1.  Search groups + show criteria
    2.  Search groups + criteria + VM members

  {cB('TAGS')}     {cD('(Local Managers only)')}
  {d}
    3.  Show all tags on a VM
    4.  Find all VMs carrying a specific tag
    5.  Add / remove tags                      {cD('(audit logged)')}

  {cB('BULK & ANALYSIS')}
  {d}
    6.  Bulk tag from CSV                      {cD('(dry-run first)')}
    7.  Reverse lookup: VM -> groups -> rules  {cD('(any member type, deduped)')}
    8.  Parity validation (static vs dynamic)
    9.  Compliance dashboard

  {cB('OPERATIONS')}
  {d}
   10.  Verify connectivity + API detection
   11.  View audit log / undo
   12.  Toggle write mode                      [{mode_str}]
   13.  Generate change ticket from CSV
   14.  List managers

    m.  Show this menu again    q.  Quit
{h}
"""


def interactive(sessions, audit, exporter, write_enabled):
    say(_menu_text(cBG("READ-WRITE") if write_enabled else cBY("READ-ONLY")))
    say(f"  Tip: {cD('m = menu, b = back mid-prompt, q = quit')}")

    while True:
        mode_str = cBG("READ-WRITE") if write_enabled else cBY("READ-ONLY")
        try:
            c = ask(f"\n  Choice [{mode_str}{cD(']:')} ",
                    allow_back=False).strip().lower()
        except UserAbort:
            say("\n  Bye."); return 0

        try:
            if c == "q":
                say("  Bye."); return 0

            elif c == "m":
                say(_menu_text(mode_str))
                continue

            elif c == "14":
                say("")
                table(["Name", "Host", "Role"],
                      [[cC(s.name), s.host, cD(ROLE_LABEL.get(s.role,"?"))]
                       for s in sessions])

            elif c in ("1", "2"):
                tgt = select_managers(sessions, (ROLE_GM, ROLE_LM),
                                      allow_all=True, label="group search")
                if not tgt: continue
                domain = ask(f"  Domain [{DEFAULT_DOMAIN}]: ",
                             default=DEFAULT_DOMAIN)
                needle = ask("  Name/id contains (blank=all): ", default="")
                act_groups(tgt, domain, needle,
                           show_members=(c == "2"), exporter=exporter)
                offer_export(exporter)

            elif c == "3":
                tgt = select_managers(sessions, (ROLE_LM,),
                                      allow_all=True, label="VM tag lookup")
                if not tgt: continue
                vm = ask("  VM name contains: ")
                if vm:
                    act_vm_tags(tgt, vm, exporter)
                    offer_export(exporter)

            elif c == "4":
                tgt = select_managers(sessions, (ROLE_LM,),
                                      allow_all=True, label="tag search")
                if not tgt: continue
                scope = ask("  Tag scope (blank=any): ", default="")
                tag = ask("  Tag value (blank=any): ", default="")
                if not scope and not tag:
                    say("    Give a scope, a value, or both."); continue
                act_vms_by_tag(tgt, scope, tag, exporter)
                offer_export(exporter)

            elif c == "5":
                tgt = select_managers(sessions, (ROLE_LM,),
                                      allow_all=True, label="tag management")
                if not tgt: continue
                vm = ask("  VM name contains: ")
                if vm:
                    act_manage_tags(tgt, vm, audit, write_enabled)

            elif c == "6":
                tgt = select_managers(sessions, (ROLE_LM,),
                                      allow_all=True, label="bulk tagging")
                if not tgt: continue
                csv_path = ask("  CSV file path: ")
                if not csv_path: continue
                say(f"\n  {cBY('DRY RUN')} first ...")
                act_bulk_tag(tgt, csv_path, audit, write_enabled, dry_run=True)
                if write_enabled:
                    if confirm(f"\n  {cB('Apply for real?')} [y/N]: "):
                        act_bulk_tag(tgt, csv_path, audit, write_enabled,
                                     dry_run=False)
                    else:
                        say("  Cancelled.")

            elif c == "7":
                # Always sweeps every connected manager -- see docstring on
                # act_reverse_lookup for why a partial selection is wrong here.
                domain = ask(f"  Domain [{DEFAULT_DOMAIN}]: ",
                             default=DEFAULT_DOMAIN)
                vm = ask("  VM name contains: ")
                if vm:
                    act_reverse_lookup(sessions, vm, domain, exporter)
                    offer_export(exporter)

            elif c == "8":
                static = ask("  Static group name/id: ")
                if not static: continue
                dynamic = ask("  Dynamic group name/id: ")
                if not dynamic: continue
                domain = ask(f"  Domain [{DEFAULT_DOMAIN}]: ",
                             default=DEFAULT_DOMAIN)
                act_parity(sessions, domain, static, dynamic, exporter)
                offer_export(exporter)

            elif c == "9":
                act_dashboard(sessions, exporter)
                offer_export(exporter)

            elif c == "10":
                tgt = select_managers(sessions, (ROLE_GM, ROLE_LM),
                                      allow_all=True, label="verification")
                if tgt:
                    act_verify(tgt)

            elif c == "11":
                act_audit_log(audit, sessions, write_enabled)

            elif c == "12":
                write_enabled = not write_enabled
                say(f"  Write mode: "
                    f"{cBG('ENABLED') if write_enabled else cBY('DISABLED')}")

            elif c == "13":
                csv_path = ask("  CSV file path: ")
                if csv_path:
                    domain = ask(f"  Domain [{DEFAULT_DOMAIN}]: ",
                                 default=DEFAULT_DOMAIN)
                    act_change_ticket(sessions, csv_path, domain,
                                     audit, exporter)

            elif c == "":
                continue

            else:
                hint = cD("'m' for menu")
                say(f"  Not a valid choice. ({hint})")

        except UserAbort:
            say("  (backed out)")
            continue
        except NsxError as e:
            err(str(e))
        except Exception as e:
            err(f"unexpected: {e}")
        # No "press Enter to continue" + full-menu reprint here on purpose:
        # that pattern is what pushed results off-screen. The compact
        # prompt above appears right after the output instead.


